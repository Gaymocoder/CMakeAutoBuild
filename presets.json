{
    "clang": {
        "cmake": {
            "description": "Clang + LLVM libc++",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "./cmake/unix-libc++.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Linux",
            "arch": "x86_64",
            "compiler": "clang",
            "compiler.version": "17",
            "compiler.libcxx": "libc++",
            "build_type": "Release"
        },
        "github_ci": {
            "run-file": ["clang.sh"]
        }
    },
    
    "clang-gcc": {
        "cmake": {
            "description": "Clang + GCC libstdc++",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "./cmake/unix-libstdc++.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Linux",
            "arch": "x86_64",
            "compiler": "clang",
            "compiler.version": "17",
            "compiler.libcxx": "libstdc++11",
            "build_type": "Release"
        },
        "github_ci": {
            "run-file": ["clang.sh", "g++.sh"]
        }
    },
    
    "clang-mingw": {
        "cmake": {
            "description": "Clang + MinGW libstdc++",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "./cmake/w64-mingw32.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Windows",
            "arch": "x86_64",
            "compiler": "clang",
            "compiler.version": "22",
            "compiler.libcxx": "libstdc++11",
            "build_type": "Release"
        },
        "github_ci": {
            "uses": [
                {
                    "uses": "KyleMayes/install-llvm-action@v2",
                    "with": {
                        "version": "22"
                    }
                },
                {
                    "uses": "egor-tensin/setup-mingw@v2",
                    "with": {
                        "platform": "x64",
                        "version": "14.2.0"
                    }
                }
            ]
        }
    },
    
    "clang-msvc": {
        "cmake": {
            "description": "Clang + MSVC++",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "./cmake/w64-msvc++.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Windows",
            "arch": "x86_64",
            "compiler": "clang",
            "compiler.version": "22",
            "compiler.runtime": "dynamic",
            "compiler.runtime_type": "Release",
            "compiler.runtime_version": "v145",
            "build_type": "Release"
        },
        "github_ci": {
            "uses": [
                {
                    "uses": "ilammy/msvc-dev-cmd@v1"
                },
                {
                    "uses": "KyleMayes/install-llvm-action@v2",
                    "with": {
                        "version": "22"
                    }
                }
            ]
        }
    },

    "gcc": {
        "cmake": {
            "description": "GNU C Compiler for Unix Makefiles",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "./build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Linux",
            "arch": "x86_64",
            "compiler": "gcc",
            "compiler.version": "14",
            "compiler.libcxx": "libstdc++11",
            "build_type": "Release"
        },
        "github_ci": {
            "run-file": ["g++.sh"]
        }
    },
    
    "mingw32": {
        "cmake": {
            "description": "MinGW32",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "./build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Windows",
            "arch": "x86_64",
            "compiler": "gcc",
            "compiler.version": "14",
            "compiler.libcxx": "libstdc++11",
            "build_type": "Release"
        },
        "github_ci": {
            "uses": [
                {
                    "uses": "egor-tensin/setup-mingw@v2",
                    "with": {
                        "platform": "x64",
                        "version": "14.2.0"
                    }
                }
            ]
        }
    },
    
    "msvc": {
        "cmake": {
            "description": "MSVC++",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "./build/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        "conan": {
            "os": "Windows",
            "arch": "x86_64",
            "compiler": "msvc",
            "compiler.version": "193",
            "compiler.runtime": "dynamic",
            "compiler.runtime_type": "Release",
            "build_type": "Release"
        },
        "github_ci": {
            "uses": [
                {
                    "uses": "ilammy/msvc-dev-cmd@v1"
                }
            ]
        }
    }
}